CONFIG_BT=m
CONFIG_USB_USBNET=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# BPI-specific: Use fixed 16MB CMA (instead of 50% = 64MB on 128MB board)
# This gives more memory to user applications
# CONFIG_CMA_SIZE_SEL_PERCENTAGE is not set
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_CMA=y
CONFIG_DMA_CMA=y

# Enable V4L2 support for USB cameras (required by libv4l)
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEOBUF2_CORE=y
CONFIG_VIDEOBUF2_V4L2=y
CONFIG_VIDEOBUF2_MEMOPS=y
CONFIG_VIDEOBUF2_VMALLOC=y

# Disable all on-board camera/video/GPU/AI drivers to save memory  
# CONFIG_VPU_CANAAN is not set
# CONFIG_GPU_VGLITE is not set
# CONFIG_K230_GNNE_DRIVER is not set
# CONFIG_K230_AI2D_DRIVER is not set

