From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: K230 SDK <k230@example.com>
Date: Sun, 27 Jul 2026 12:30:00 -0700
Subject: [PATCH] cmake: do not force warnings as errors

Cross-build warning policy belongs to Buildroot and the selected toolchain.
Forcing -Werror in an external package makes otherwise harmless warnings from
newer cross compilers fail the target build.
---
 CMakeLists.txt | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -42,10 +42,5 @@ if(CMAKE_COMPILER_IS_GNUCC OR CMAKE_C_COMPILER_ID MATCHES "Clang")
     endif()
     add_compile_options(-Wno-shift-negative-value)
-    if(${CMAKE_VERSION} VERSION_GREATER_EQUAL "3.24.0")
-      set(CMAKE_COMPILE_WARNING_AS_ERROR ON)
-    else()
-      add_compile_options(-Werror)
-    endif()
 endif()
 
 if(CMAKE_C_COMPILER_ID MATCHES "Clang" AND CMAKE_C_SIMULATE_ID MATCHES "MSVC")
-- 
2.43.0
