+
+int main(void)
+{
+    unsigned char pixels_a[64 * 64];
+    unsigned char pixels_b[64 * 64];
+    memset(pixels_a, 0, sizeof(pixels_a));
+    for (int i = 0; i < 64 * 64; i++) pixels_b[i] = (unsigned char)i;
+    image_u8_t image_a = make_image(pixels_a, 64, 64);
+    image_u8_t image_b = make_image(pixels_b, 64, 64);
+    apriltag_detector_t *first = c_apriltag_detector_create();
+    apriltag_detector_t *second = c_apriltag_detector_create();
+    apriltag_workload_counters_t a, b, before;
+    CHECK(first && second);
+
+    zarray_t *detections = c_apriltag_detector_detect(first, &image_a);
+    CHECK(detections);
+    c_apriltag_detections_destroy(detections);
+    CHECK(c_apriltag_get_workload_counters_v2(first, &a, sizeof(a)) == 0);
+    CHECK(a.validity == APRILTAG_WORKLOAD_VALID_INPUT);
+    CHECK(a.input_width == 64 && a.input_height == 64);
+
+    apriltag_family_t *family = c_tag36h11_create();
+    c_apriltag_detector_add_family_bits(first, family, 0);
+    detections = c_apriltag_detector_detect(first, &image_a);
+    CHECK(detections);
+    c_apriltag_detections_destroy(detections);
+    CHECK(c_apriltag_get_workload_counters_v2(first, &a, sizeof(a)) == 0);
+    CHECK((a.validity & APRILTAG_WORKLOAD_VALID_COMMON_DECODE) != 0);
+    CHECK((a.validity & APRILTAG_WORKLOAD_VALID_COMPARABLE_LINE_FIT) == 0);
+    CHECK((a.validity & APRILTAG_WORKLOAD_VALID_COMPARABLE_BOUNDARY_CANDIDATES) == 0);
+    CHECK(a.boundary_candidates == 0);
+    CHECK(a.threshold_black_pixels + a.threshold_uncertain_pixels +
+           a.threshold_white_pixels == a.decimated_width * a.decimated_height);
+    CHECK(a.clusters_after_filters + a.cluster_reject_too_few_points +
+           a.cluster_reject_too_large <= a.clusters_created);
+    CHECK(a.quad_family_candidates == a.homography_rejects +
+           a.family_polarity_rejects + a.decode_attempts);
+
+    CHECK(c_apriltag_get_workload_counters_v2(first, &before, sizeof(before)) == 0);
+    apriltag_family_t *second_family = c_tag36h11_create();
+    c_apriltag_detector_add_family_bits(second, second_family, 0);
+    detections = c_apriltag_detector_detect(second, &image_b);
+    CHECK(detections);
+    c_apriltag_detections_destroy(detections);
+    CHECK(c_apriltag_get_workload_counters_v2(second, &b, sizeof(b)) == 0);
+    CHECK(c_apriltag_get_workload_counters_v2(first, &a, sizeof(a)) == 0);
+    CHECK(memcmp(&a, &before, sizeof(a)) == 0);
+    CHECK(a.decimated_checksum != b.decimated_checksum);
+
+    second->nthreads = 2;
+    errno = 0;
+    CHECK(c_apriltag_detector_detect(second, &image_b) == NULL);
+    CHECK(errno == EINVAL);
+    CHECK(c_apriltag_get_workload_counters_v2(second, &b, sizeof(b)) == 0);
+    CHECK(b.validity == APRILTAG_WORKLOAD_VALID_INPUT);
+
+    c_apriltag_detector_destroy(first);
+    c_apriltag_detector_destroy(second);
+    c_tag36h11_destroy(family);
+    c_tag36h11_destroy(second_family);
+    return 0;
+}
