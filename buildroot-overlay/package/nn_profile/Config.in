config BR2_PACKAGE_NN_PROFILE
    bool "generic neural-network profiler"
    depends on BR2_TOOLCHAIN_HAS_THREADS
    depends on !BR2_STATIC_LIBS
    select BR2_PACKAGE_LINUX_TOOLS_PERF
    help
        Generic Linux profiler for statically compiled neural-network
        plugins. It reports latency, throughput, work-normalized metrics,
        and available hardware performance counters.

        Model plugins are supplied separately so private model weights and
        kernel sources never enter this public SDK tree.
