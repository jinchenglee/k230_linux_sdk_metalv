if TARGET_K230_CANMV

config SYS_CPU
	default "k230"

config SYS_VENDOR
    default "canaan"

config SYS_BOARD
    default "k230_canmv"

config SYS_CONFIG_NAME
    default "k230_evb"


config BOARD_SPECIFIC_OPTIONS # dummy
	def_bool y
	select RISCV_THEAD

config LINUX_RUN_CORE_ID
	int "Linux boot core"
	range 0 1
	default 1
	help
	  Select the K230 SoC CPU slot that runs U-Boot and Linux. Slot 0 keeps
	  execution on the booted small core; slot 1 releases the big core and
	  parks the small core, preserving the vendor single-Linux behavior.

choice
	prompt "ddr typy freq"
    default CANMV_LPDDR3_2133

    config CANMV_LPDDR3_2133
        bool  "k230 canmv ddr3 2133"

    config CANMV_V3_LPDDR4_2667
	    bool "canmv v3 LP4_2667"
        help
            "CANMV V3,lushanpai,01studio"

    config CANMV_V3_LPDDR4_3200
	    bool "canmv v3 LP4_3200"
        help
            "CANMV V3,lushanpai,01studio"

    config CANMV_LPDDR4_1600_WITHOUT_ODT
	    bool "canmv  LP4_1600 WITHOUT ODT,"
        help
            "CANMV V3,lushanpai,01studio"
endchoice
endif
